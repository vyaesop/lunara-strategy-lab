# Copy to apps/api/.env (gitignored). The API and `pnpm db:migrate` load it
# automatically; real environment variables win. Tests ignore it.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# Neon (or any Postgres) connection string. Leave unset for local development:
# the API then uses an embedded PGlite database in apps/api/.data/pglite.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── Auth (Better Auth) ────────────────────────────────────────────────────
# Required in production. Generate: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Public URL of this API (used for auth callbacks and cookies)
BETTER_AUTH_URL=http://localhost:8787
# Comma-separated client origins allowed to call the API with credentials.
# capacitor://localhost is Android/iOS in Capacitor; https://localhost is Android's scheme.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost

# ── AI providers (all optional; default is the deterministic mock) ────────
# Free tiers and caveats: docs/AI_PROVIDERS.md. Providers without a key are skipped.
AI_PROVIDER_DEFAULT=mock
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# NVIDIA_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# OLLAMA_BASE_URL=http://localhost:11434
# Any other OpenAI-compatible endpoint:
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# Ordered fallbacks for every task ("provider" or "provider:model"):
# AI_FALLBACKS=openrouter,gemini,mistral,cloudflare
# AI_MODEL_CHEAP=
# AI_MODEL_STRONG=
# AI_MODEL_EMBED=
# Per-task override, e.g. AI_ROUTE_COACH_ASSESS=gemini:gemini-3.5-flash
# Providers approved to receive private user-authored content (see docs/AI_PROVIDERS.md)
AI_ALLOW_USER_CONTENT=mock,ollama

# ── Administration ────────────────────────────────────────────────────────
# Comma-separated emails that receive the admin flag (server-side) when they sign in.
# ADMIN_EMAILS=you@example.com

# ── Limits ────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AI_DAILY_REQUEST_LIMIT=200
AI_MONTHLY_COST_LIMIT_USD=5
