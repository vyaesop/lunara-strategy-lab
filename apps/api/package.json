{
  "name": "@lunara/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted backend: auth, sessions, AI routing, usage limits. Hono on Node; Postgres (Neon) via Drizzle, PGlite for local dev.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@lunara/ai": "workspace:*",
    "@lunara/core": "workspace:*",
    "@lunara/curriculum": "workspace:*",
    "@lunara/schemas": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
