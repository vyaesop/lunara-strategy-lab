{
  "name": "@lunara/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web app and Capacitor mobile shell (one React codebase).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "cap:sync": "vite build && cap sync",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "android:debug": "pnpm cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@lunara/core": "workspace:*",
    "@lunara/schemas": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
