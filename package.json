{
  "name": "lunara-strategy-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @lunara/api --filter @lunara/client dev",
    "dev:api": "pnpm --filter @lunara/api dev",
    "dev:client": "pnpm --filter @lunara/client dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @lunara/client test:e2e",
    "db:generate": "pnpm --filter @lunara/api db:generate",
    "db:migrate": "pnpm --filter @lunara/api db:migrate",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^5.0.2"
  }
}
